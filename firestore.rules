rules_version = '2';

// กฎความปลอดภัยของ Pawmate
// วางกฎนี้ที่ Firebase Console -> Firestore Database -> แท็บ Rules -> Publish
//
// หลักการ: เว็บเปิดสาธารณะ ใครก็เข้าได้ จึงกันไม่ได้ว่า "ใครอ่านห้องไหน"
// (ความเป็นส่วนตัวอยู่ที่การตั้งรหัสห้องให้เดายาก)
// แต่กันได้ว่า ต้องล็อกอินก่อน / เขียนทับ presence คนอื่นไม่ได้ / ยัดข้อมูลใหญ่ ๆ ไม่ได้
// เพื่อไม่ให้ใครยิงข้อมูลขยะจนเปลืองโควตา

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function validMember() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 20
             && d.pet is string && d.pet.size() <= 10
             && d.points is number && d.points >= 0 && d.points <= 1000000
             && d.lastSeen is number;
    }

    function validTask() {
      let d = request.resource.data;
      return d.text is string && d.text.size() > 0 && d.text.size() <= 100
             && d.category is string && d.category.size() <= 20
             && d.date is string && d.date.size() == 10
             && d.points is number && d.points >= 0 && d.points <= 100
             && d.done is bool;
    }

    // ข้อความจะมีแค่ตัวหนังสือ หรือแค่รูป หรือทั้งคู่ก็ได้ แต่ต้องมีอย่างน้อยหนึ่งอย่าง
    // รูปเก็บเป็น base64 data URL — จำกัดขนาดไม่ให้ชน 1MB ที่เป็นเพดานของ Firestore
    function validMessage() {
      let d = request.resource.data;
      return d.name is string && d.name.size() <= 20
             && d.ts is number
             && d.text is string && d.text.size() <= 300
             && (
                  !d.keys().hasAny(['image'])
                  || (d.image is string
                      && d.image.size() <= 700000
                      && d.image.matches('data:image/.*'))
                )
             && (d.text.size() > 0 || d.keys().hasAny(['image']));
    }

    // ข้อความเก่าเกิน 21 วัน (~3 อาทิตย์) — เลขนี้ต้องตรงกับ IMAGE_TTL_MS ในเว็บ
    // ให้ระบบเก็บกวาดรูปออกได้เอง (ตัวหนังสือไม่ถูกลบ อยู่ถาวรเสมอ)
    function messageImageExpired() {
      return resource.data.ts is number
             && resource.data.ts < request.time.toMillis() - 1814400000;
    }

    match /rooms/{room} {

      allow read: if isSignedIn();

      // presence ของสมาชิก — แก้ได้เฉพาะเอกสารของ uid ตัวเอง
      match /members/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == uid && validMember();
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }

      // งาน — ใครในห้องก็เพิ่ม/ปิด/ลบได้ (เป็นกระดานร่วมของทีม)
      match /tasks/{taskId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && validTask();
        allow delete: if isSignedIn();
      }

      // แชท — เขียนใหม่ได้, แก้ตัวหนังสือ/รูปเดิมไม่ได้ (แก้ได้แค่ติ๊กสำคัญ หรือระบบลบรูปเก่าออกอัตโนมัติ)
      // ลบได้เฉพาะข้อความของตัวเอง หรือข้อความรูปล้วน (ไม่มีตัวหนังสือ) ที่เก่าเกิน 21 วัน (เก็บกวาดอัตโนมัติ)
      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && validMessage();
        allow update: if isSignedIn()
                      && (
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['important'])
                            && request.resource.data.important is bool)
                           || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['image', 'imageRemoved'])
                               && !request.resource.data.keys().hasAny(['image'])
                               && request.resource.data.imageRemoved == true
                               && messageImageExpired())
                         );
        allow delete: if isSignedIn()
                      && (request.auth.uid == resource.data.fromId
                          || (resource.data.text.size() == 0 && messageImageExpired()));
      }

      // event ชั่วคราว (ทัก/โฟกัส) — ลบได้เพื่อให้แอปเก็บกวาดของเก่า
      match /events/{eventId} {
        allow read, delete: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.ts is number;
        allow update: if false;
      }

      // สถานะร่วมของห้อง เช่น ธีม
      match /meta/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn()
                     && request.resource.data.keys().hasOnly(['themeId', 'ts'])
                     && request.resource.data.themeId is string
                     && request.resource.data.themeId.size() <= 20;
      }
    }
  }
}
